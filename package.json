{
  "name": "lankapost",
  "version": "1.0.0",
  "description": "Comprehensive, clean, and zero-dependency dataset and search utility for Sri Lanka postal codes and post offices.",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./data": "./data/postal_codes.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/test_js.js"
  },
  "keywords": [
    "lankapost",
    "sri-lanka",
    "postal-codes",
    "zip-codes",
    "post-offices",
    "sri-lanka-post",
    "lanka",
    "colombo",
    "kandy",
    "galle",
    "districts",
    "provinces"
  ],
  "author": "Antigravity Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbQaadir/lankapost.git"
  },
  "bugs": {
    "url": "https://github.com/AbQaadir/lankapost/issues"
  },
  "homepage": "https://github.com/AbQaadir/lankapost#readme"
}
